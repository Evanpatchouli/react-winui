{
  "name": "@evanpatchouli/react-winui",
  "version": "1.1.0",
  "description": "Build full featured Windows fluent UI apps using ReactJS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/Button/index.d.ts",
      "import": "./dist/components/Button/index.js",
      "default": "./dist/components/Button/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/components/Breadcrumb/index.d.ts",
      "import": "./dist/components/Breadcrumb/index.js",
      "default": "./dist/components/Breadcrumb/index.js"
    },
    "./auto-suggest-box": {
      "types": "./dist/components/AutoSuggestBox/index.d.ts",
      "import": "./dist/components/AutoSuggestBox/index.js",
      "default": "./dist/components/AutoSuggestBox/index.js"
    },
    "./combo-box": {
      "types": "./dist/components/ComboBox/index.d.ts",
      "import": "./dist/components/ComboBox/index.js",
      "default": "./dist/components/ComboBox/index.js"
    },
    "./command-bar": {
      "types": "./dist/components/CommandBar/index.d.ts",
      "import": "./dist/components/CommandBar/index.js",
      "default": "./dist/components/CommandBar/index.js"
    },
    "./calendar": {
      "types": "./dist/components/Calendar/index.d.ts",
      "import": "./dist/components/Calendar/index.js",
      "default": "./dist/components/Calendar/index.js"
    },
    "./data-grid": {
      "types": "./dist/components/DataGrid/index.d.ts",
      "import": "./dist/components/DataGrid/index.js",
      "default": "./dist/components/DataGrid/index.js"
    },
    "./tooltip": {
      "types": "./dist/components/Tooltip/index.d.ts",
      "import": "./dist/components/Tooltip/index.js",
      "default": "./dist/components/Tooltip/index.js"
    },
    "./popover": {
      "types": "./dist/components/Popover/index.d.ts",
      "import": "./dist/components/Popover/index.js",
      "default": "./dist/components/Popover/index.js"
    },
    "./flyout": {
      "types": "./dist/components/Flyout/index.d.ts",
      "import": "./dist/components/Flyout/index.js",
      "default": "./dist/components/Flyout/index.js"
    },
    "./teaching-tip": {
      "types": "./dist/components/TeachingTip/index.d.ts",
      "import": "./dist/components/TeachingTip/index.js",
      "default": "./dist/components/TeachingTip/index.js"
    },
    "./context-menu": {
      "types": "./dist/components/ContextMenu/index.d.ts",
      "import": "./dist/components/ContextMenu/index.js",
      "default": "./dist/components/ContextMenu/index.js"
    },
    "./toast": {
      "types": "./dist/components/Toast/index.d.ts",
      "import": "./dist/components/Toast/index.js",
      "default": "./dist/components/Toast/index.js"
    },
    "./info-bar": {
      "types": "./dist/components/InfoBar/index.d.ts",
      "import": "./dist/components/InfoBar/index.js",
      "default": "./dist/components/InfoBar/index.js"
    },
    "./expander": {
      "types": "./dist/components/Expander/index.d.ts",
      "import": "./dist/components/Expander/index.js",
      "default": "./dist/components/Expander/index.js"
    },
    "./number-box": {
      "types": "./dist/components/NumberBox/index.d.ts",
      "import": "./dist/components/NumberBox/index.js",
      "default": "./dist/components/NumberBox/index.js"
    },
    "./navigation-view": {
      "types": "./dist/components/NavigationView/index.d.ts",
      "import": "./dist/components/NavigationView/index.js",
      "default": "./dist/components/NavigationView/index.js"
    },
    "./settings-card": {
      "types": "./dist/components/SettingsCard/index.d.ts",
      "import": "./dist/components/SettingsCard/index.js",
      "default": "./dist/components/SettingsCard/index.js"
    },
    "./settings-expander": {
      "types": "./dist/components/SettingsExpander/index.d.ts",
      "import": "./dist/components/SettingsExpander/index.js",
      "default": "./dist/components/SettingsExpander/index.js"
    },
    "./date-picker": {
      "types": "./dist/components/DatePicker/index.d.ts",
      "import": "./dist/components/DatePicker/index.js",
      "default": "./dist/components/DatePicker/index.js"
    },
    "./tree-view": {
      "types": "./dist/components/TreeView/index.d.ts",
      "import": "./dist/components/TreeView/index.js",
      "default": "./dist/components/TreeView/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": "./dist/react-winui.min.css",
    "./dist/react-winui.min.css": "./dist/react-winui.min.css",
    "./config/app-config.css": "./config/app-config.css",
    "./icons/winui-icons.min.css": "./icons/winui-icons.min.css",
    "./icons/winui-icons.slim.css": "./icons/winui-icons.slim.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "config",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:styles": "node scripts/build.mjs --styles-only",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sass": "^1.103.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://evanpatchouli.github.io/react-winui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evanpatchouli/react-winui.git"
  },
  "keywords": [
    "react",
    "windows",
    "ui",
    "fluentui",
    "windows11",
    "user-interface",
    "react-component",
    "responsive",
    "uwp",
