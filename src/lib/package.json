{
  "name": "@evanpatchouli/react-winui",
  "version": "1.0.0",
  "description": "Build full featured Windows fluent UI apps using ReactJS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/Button/index.d.ts",
      "import": "./dist/components/Button/index.js",
      "default": "./dist/components/Button/index.js"
    },
    "./tooltip": {
      "types": "./dist/components/Tooltip/index.d.ts",
      "import": "./dist/components/Tooltip/index.js",
      "default": "./dist/components/Tooltip/index.js"
    },
    "./styles.css": "./dist/react-winui.min.css",
    "./dist/react-winui.min.css": "./dist/react-winui.min.css",
    "./config/app-config.css": "./config/app-config.css",
    "./icons/winui-icons.min.css": "./icons/winui-icons.min.css",
    "./icons/winui-icons.slim.css": "./icons/winui-icons.slim.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "config",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:styles": "node scripts/build.mjs --styles-only",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sass": "^1.103.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://virtualvivek.github.io/react-winui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtualvivek/react-winui.git"
  },
  "keywords": [
    "react",
    "windows",
    "ui",
    "fluentui",
    "windows11",
    "user-interface",
    "react-component",
    "responsive",
    "uwp",
    "electronJS",
    "mobile",
    "windows-app",
    "ui-design",
    "web-app"
  ],
  "author": {
    "name": "Vivek Verma",
    "email": "virtualvivek7@gmail.com"
  },
  "license": "MIT"
}
