{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "react-winui": ["src/lib/src/index.ts"],
      "react-winui/*": ["src/lib/src/*"]
    }
  },
  "include": [
    "src/lib/src/**/*.ts",
    "src/lib/src/**/*.tsx",
    "src/lib/src/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "apps/docs/**/*.d.ts",
    "src/lib/vite.config.js",
    "src/lib/scripts/**/*.mjs",
    "vitest.config.js",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "src/lib/dist", "build", "src/demo"]
}
